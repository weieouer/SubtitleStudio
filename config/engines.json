{
  "version": 1,
  "pip_cache": "data/cache/pip",
  "indexes": [
    "https://mirrors.aliyun.com/pypi/simple",
    "https://pypi.tuna.tsinghua.edu.cn/simple",
    "https://mirrors.ustc.edu.cn/pypi/simple",
    "https://repo.huaweicloud.com/repository/pypi/simple",
    "https://mirrors.cloud.tencent.com/pypi/simple",
    "https://pypi.org/simple"
  ],
  "torch": {
    "mode": "manual",
    "cuda_index": "https://download.pytorch.org/whl/cu126",
    "packages": ["torch", "torchaudio"]
  },
  "engines": {
    "qwen": {
      "packages": ["qwen-asr==0.0.6", "gradio<6"],
      "probe": "from qwen_asr import Qwen3ASRModel, Qwen3ForcedAligner",
      "torch": true
    },
    "firered": {
      "packages": ["https://github.com/FireRedTeam/FireRedASR2S/archive/refs/heads/main.zip", "kaldi_native_fbank"],
      "probe": "from fireredasr2s.fireredasr2 import FireRedAsr2, FireRedAsr2Config",
      "torch": true
    }
  }
}
